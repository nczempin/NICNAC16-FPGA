 .timescale -9 -9;
    .port_info 0 /INPUT 1 "clk";
o0x7f568cd77018 .functor BUFZ 1, C4<z>; HiZ drive
v0x564e66107430_0 .net "clk", 0 0, o0x7f568cd77018;  0 drivers
L_0x7f568cd2e018 .functor BUFT 1, C4<x>, C4<0>, C4<0>, C4<0>;
v0x564e6613c260_0 .net "my_signal_1", 0 0, L_0x7f568cd2e018;  1 drivers
L_0x7f568cd2e060 .functor BUFT 1, C4<0>, C4<0>, C4<0>, C4<0>;
v0x564e6613c320_0 .net "my_signal_2", 0 0, L_0x7f568cd2e060;  1 drivers
